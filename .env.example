# Flood Digital Twin + RescueNet X 2.0: configuration example.
# Copy to backend/.env (the backend reads .env from the folder it is started in). Every value is optional.

# ---- Backend
# development | production (default production). Development enables developer conveniences added in later
# milestones; production refuses them. Set it explicitly.
RESCUENET_ENV=development
# Where automatic pre-migration backups go (default backend/backups, git-ignored)
BACKUP_DIR=
DEBUG=True
DATABASE_URL="sqlite:///./backend/rescuenet.db"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# ---- Public reporting and evidence photos (limits shown are the defaults)
UPLOAD_DIR=
UPLOAD_QUOTA_MB=2048
GUEST_UPLOAD_MB_PER_DAY=50
GUEST_REPORTS_PER_HOUR=10
GUEST_UPLOADS_PER_HOUR=25
# Number of trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For (it can be forged).
TRUSTED_PROXY_COUNT=0

# ---- Sign-in
# Secret used to sign login tokens. If empty, a random one is created in backend/.jwt_secret on first start.
# Set it yourself when several machines serve the app, so tokens stay valid across them.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480
# Demo accounts for every role (admin, commander, operator, officer, volunteer, citizen), created on an empty database.
# Turn OFF for any real use. When off, one admin account is created: set RESCUENET_ADMIN_PASSWORD or
# read the generated password printed at first start (and saved to backend/.admin_password).
SEED_DEMO_USERS=true
DEMO_USER_PASSWORD=Rescue@2026
RESCUENET_ADMIN_PASSWORD=

# ---- LoRa gateways (devices do not sign in; they send this key in the X-Gateway-Key header)
LORA_GATEWAY_KEY=

# ---- Local AI supervisor (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# ---- Frontend (read by Vite, put in rescuenet-x2/frontend/.env)
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
