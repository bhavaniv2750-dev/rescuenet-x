# Flood Digital Twin + RescueNet X 2.0: configuration example.
# Copy to backend/.env (the backend reads .env from the folder it is started in). Every value is optional.

# ---- Backend
# development | production (default production). Development enables developer conveniences added in later
# milestones; production refuses them. Set it explicitly.
RESCUENET_ENV=development
# Where automatic pre-migration backups go (default backend/backups, git-ignored)
BACKUP_DIR=
DEBUG=True
DATABASE_URL="sqlite:///./backend/rescuenet.db"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:5174","http://127.0.0.1:5174"]

# ---- Public reporting and evidence photos (limits shown are the defaults)
UPLOAD_DIR=
UPLOAD_QUOTA_MB=2048
GUEST_UPLOAD_MB_PER_DAY=50
GUEST_REPORTS_PER_HOUR=10
GUEST_UPLOADS_PER_HOUR=25
# Number of trusted reverse proxies in front of the app. 0 = ignore X-Forwarded-For (it can be forged).
TRUSTED_PROXY_COUNT=0

# ---- Sign-in
# Secret used to sign login tokens. If empty, a random one is created in backend/.jwt_secret on first start.
# Set it yourself when several machines serve the app, so tokens stay valid across them.
JWT_SECRET=
# Access tokens are short-lived (default 15 minutes, never more than 60). Sessions are server-side and renewed with a
# rotating refresh token kept in an HttpOnly cookie.
ACCESS_TOKEN_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
SESSION_IDLE_MINUTES=60
# "Keep me signed in" (citizens and volunteers only)
REMEMBER_ABSOLUTE_DAYS=7
REMEMBER_IDLE_HOURS=24
MAX_SESSIONS_PER_USER=10
# Extra browser origins (comma separated) that may call the cookie-authenticated endpoints, e.g. a reverse proxy origin.
# Same-origin deployments need nothing here.
TRUSTED_ORIGINS=
# Development fixtures (simulated demo accounts). OFF by default. They are created only on an EMPTY database, only when
# RESCUENET_ENV=development AND this is set to true; production refuses to start with it on. There is no built-in password:
# set DEMO_USER_PASSWORD yourself, or leave it empty and a random one is printed ONCE to the console.
SEED_DEMO_USERS=false
DEMO_USER_PASSWORD=
# Production: create the first administrator with `python scripts/bootstrap_admin.py --help` (host access required);
# further staff by invitation: `python scripts/account_admin.py invite --help`. See docs/security/S5_ACCOUNTS_AGENCIES.md.
# Production requires JWT_SECRET (32+ characters) and MFA_ENCRYPTION_KEYS; check with `python scripts/check_config.py`.
# Browser origins allowed in production (comma separated; same-origin deployments need none). Localhost is development-only.
CORS_ORIGINS_PRODUCTION=
# Invitation link lifetime in hours (1-168) and whether privileged accounts must verify an email address (default: production only).
INVITATION_HOURS=72
# PRIVILEGED_REQUIRE_VERIFIED_EMAIL=true

# ---- Email (verification codes, password recovery). Without SMTP_HOST: development uses a labelled outbox (nothing is
# delivered), production delivers nothing and says so. SMS is disabled: no SMS provider is integrated.
PUBLIC_APP_URL=http://127.0.0.1:5175
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
VERIFY_CODE_MINUTES=10
VERIFY_MAX_ATTEMPTS=5
VERIFY_RESEND_COOLDOWN_S=60
RESET_TOKEN_MINUTES=30
STAFF_RESET_COOLDOWN_HOURS=24
# Rate limits (shared, persistent, kept in the application database)
LOGIN_PER_IP_15MIN=30
LOGIN_PER_ACCOUNT_15MIN=5
REGISTER_PER_IP_HOUR=10
FORGOT_PER_IP_HOUR=5
FORGOT_PER_IDENTIFIER_HOUR=3
RESET_PER_IP_HOUR=10

# ---- Multi-factor authentication (TOTP). REQUIRED in production: the app refuses to start without a valid key.
# 32 random bytes, base64url: python backend/scripts/mfa_keys.py generate. "id:KEY[,older-id:OLDKEY]" (first encrypts, all decrypt).
# Keep it in the deployment's secret store, NOT in the database, repository or database backups.
MFA_ENCRYPTION_KEYS=
MFA_ISSUER=RescueNet X
MFA_FRESH_MINUTES=10
MFA_APPROVAL_FRESH_MINUTES=5
PRIVILEGED_REQUIRE_VERIFIED_EMAIL=false

# ---- LoRa gateways (devices do not sign in; they send this key in the X-Gateway-Key header)
LORA_GATEWAY_KEY=

# ---- Local AI supervisor (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=60

# ---- Frontend (read by Vite, put in rescuenet-x2/frontend/.env)
VITE_API_BASE_URL="http://127.0.0.1:8000/api"
